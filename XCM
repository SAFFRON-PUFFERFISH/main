void front(){

  uint16_t rt = Xbox.getButtonPress(RT); //0-1023, forward //recieves trigger values from the controller allowing us to control the motors corrospondingly 
  uint16_t lt = Xbox.getButtonPress(LT); //0-1023, reverse

  if (rt > 50) { //the above 50 is acting as a deadzone, need to play around with sensitivity and actual values later on
     digitalWrite(in1, HIGH);
     digitalWrite(in2, LOW); //forward

  } 
  else if (lt > 50) { 
 
    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH); //reverse

  } else {
    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW); //stopped
  }



}

void updateFins()
{
    int straightAngle = reverseState ? 180 : 0; //changes which direction the fins will lie flat wether going forward or in reverse

    if (Xbox.getButtonPress(RIGHT))
    {
        rightf.write(straightAngle); //closes right fin
        leftf.write(90); //opens left fin
    }
    else if (Xbox.getButtonPress(LEFT))
    {
        leftf.write(straightAngle);
        rightf.write(90);
    }
    else
    {
        rightf.write(straightAngle); //closes both fins
        leftf.write(straightAngle);
    }
}

void grip_control (){ 
  
 int16_t xval = Xbox.getAnalogHat(RightHatX); //horizontal, y axis is irrelevent to us, range -32768 to 32767
  Serial.println(xval); // print the joystick value 
  // check for deadzones
  if (abs(xval) > joystick_deadzone){
    if (xval > joystick_deadzone){
      grip_angle++; 
    }
   else if (xval < -joystick_deadzone) {
      grip_angle--;
    }
  }
 grip_angle = constrain(grip_angle, grip_min_angle, grip_max_angle); // make sure the angle doesnt go outside the range (0-180)
 servo_grip.write(grip_angle);
}

// Control the wrist rotation based on the triggers. Hold R down, will turn CW onedegree every loop. so when released it stays there, and left will turn CCW. 
void wrist_control() {
 
 bool R_rotation = Xbox.getButtonPress(RB);
 bool L_rotation = Xbox.getButtonPress(LB);

 int step = 2; // degrees per loop
  // check if button is pressed
  if (R_rotation){
    // rotate servo angle
    wrist_angle += step;
  }
  else if (L_rotation){
    wrist_angle -= step;
  }
 wrist_angle = constrain(wrist_angle, wrist_min_angle, wrist_max_angle); // keep in servo limits
 servo_wrist.write(wrist_angle); // move servo 
}

void dock_transmission() {
  if (Xbox.getButtonPress(Y)) {
    send_data(macAddr_DockC, (uint8_t *)&binaryData_A, sizeof(binaryData_A));
  }
}




void setup() {
  Serial.begin(115200); //set baud rate
  

  esp_init();
  add_peer(macAddr_DockA); // ADD DOCK A as a PEER
  add_peer(macAddr_DockB); // ADD DOCK B as a PEER
  add_peer(macAddr_DockC); // ADD DOCK C as a PEER

  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT); //set pins to outouts
  pinMode(en, OUTPUT);

    // Attach servos to pins - CONFIRM PIN NUMBERS
  servo_wrist.attach(); 
  servo_grip.attach(); 
  rightf.attach(servrf);
  leftf.attach(servlf); //attaches servos to specified pins earlier

    // Set initial position for wrist psotion and grip angle
  servo_wrist.write(wrist_angle); // start at 0 degrees
  servo_grip.write(grip_angle); // start at 0 degrees

  usb.onGamepad([](const EspUsbHostGamepadEvent &event){ //runs automatically when new controller datac omes in

    getData();
     


    updateFins(); //calls fin function
    
    delay(10); //small delay to keep things running smoother
  
    // wrist control 
    wrist_control();
    // grip control
    grip_control();
    // esp_now dock transmission
    dock_transmission();    

    }


  }

  if (!usb.begin()) {
    Serial.println("USB host failed to start");
  }
}

void loop() {

  usb.task(); //services USB stack, calls the event checker, checks hardware for a new trigger

  delay(20);

}

